{
  "name": "@diogozx-org/eslint-config",
  "version": "2.0.0",
  "description": "Reusable ESLint flat configs for TypeScript and Next.js with Prettier integration",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./next": "./next.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "next.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiogoCastroSilva/eslint-config.git"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "flat-config",
    "typescript",
    "prettier"
  ],
  "author": "Diogo Silva",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DiogoCastroSilva/eslint-config/issues"
  },
  "homepage": "https://github.com/DiogoCastroSilva/eslint-config#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "typescript-eslint": "^8.58.2"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "prettier": "^3.0.0",
    "typescript": ">=5.3.0",
    "eslint-config-next": "^16.2.9"
  },
  "peerDependenciesMeta": {
    "eslint-config-next": {
      "optional": true
    }
  }
}
