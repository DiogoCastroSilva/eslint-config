{
  "name": "frontend-tooling",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for reusable frontend engineering configuration packages",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:eslint && npm run test:tsconfig && npm run test:prettier",
    "test:eslint": "npm run test --workspace=@diogozx-org/eslint-config",
    "test:tsconfig": "npm run test --workspace=@diogozx-org/tsconfig",
    "test:prettier": "npm run test --workspace=@diogozx-org/prettier-config"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiogoCastroSilva/frontend-tooling.git"
  },
  "license": "MIT"
}
